---
import { getLangFromUrl } from '@/i18n/ui'
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from '@vercel/speed-insights/astro'

import type { SiteMeta } from 'astro-pure/types'
import AnalyticsEvents from '@/components/AnalyticsEvents.astro'
import BaseHead from '@/components/BaseHead.astro'
import ViewCounter from '@/components/comment/ViewCounter.astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/SiteFooter.astro'
import ThemeProvider from '@/components/ThemeProvider.astro'
import config from '@/site-config'

// Import the global.css file here so that it is included on
// all pages through the use of the <BaseLayout /> component.
import '@/assets/styles/app.css'

interface Props {
  meta: SiteMeta & { noindex?: boolean }
  highlightColor?: string
  chrome?: boolean
  wide?: boolean
}

const {
  meta: { articleDate, description = config.description, noindex, ogImage, title },
  highlightColor,
  chrome = true,
  wide = false,
  ...props
} = Astro.props

const lang = getLangFromUrl(Astro.url)
const htmlLang = lang === 'en' ? 'en' : config.locale.lang
---

<html lang={htmlLang}>
  <head>
    <BaseHead {articleDate} {description} {noindex} {ogImage} {title} />
    <ThemeProvider />
  </head>

  <body class='flex justify-center bg-background text-foreground' {...props}>
    <div
      class:list={[
        'site-shell w-full',
        chrome && 'px-4 sm:px-7 lg:px-10',
        chrome && (wide ? 'max-w-[90rem]' : 'max-w-[70rem]')
      ]}
    >
      {chrome && <Header lang={lang} />}
      <slot />
      {chrome && <Footer />}
    </div>
    <Analytics />
    <AnalyticsEvents />
    <SpeedInsights />
    <ViewCounter />

    {/* Set highlight color */}
    <style define:vars={{ highlightColor }}>
      :global(.highlight) {
        color: var(--highlightColor, hsl(var(--primary) / var(--un-text-opacity))) !important;
      }
      :global(.highlight-bg) {
        background-color: var(
          --highlightColor,
          hsl(var(--primary) / var(--un-text-opacity))
        ) !important;
      }
    </style>
  </body>
</html>
