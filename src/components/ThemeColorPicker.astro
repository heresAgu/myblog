---
const presets = [
  { name: '蓝灰', value: '#517E94' },
  { name: '蓝色', value: '#4F8CC9' },
  { name: '紫色', value: '#7C6FE6' },
  { name: '绿色', value: '#4F9D69' },
  { name: '橙色', value: '#D9903D' },
  { name: '粉色', value: '#D875A2' }
]
---

<script is:inline>
  const THEME_COLOR_KEY = 'theme-color'
  const DEFAULT_COLOR = '#517E94'

  const normalizeHex = (value) => {
    if (!value) return DEFAULT_COLOR

    const hex = value.startsWith('#') ? value : `#${value}`

    return /^#[0-9a-fA-F]{6}$/.test(hex) ? hex.toUpperCase() : DEFAULT_COLOR
  }

  const hexToRgb = (hex) => {
    const value = normalizeHex(hex).slice(1)

    return {
      r: Number.parseInt(value.slice(0, 2), 16),
      g: Number.parseInt(value.slice(2, 4), 16),
      b: Number.parseInt(value.slice(4, 6), 16)
    }
  }

  const hexToHsl = (hex) => {
    const { r: red, g: green, b: blue } = hexToRgb(hex)

    const r = red / 255
    const g = green / 255
    const b = blue / 255

    const max = Math.max(r, g, b)
    const min = Math.min(r, g, b)

    let h = 0
    let s = 0
    const l = (max + min) / 2

    if (max !== min) {
      const d = max - min

      s = l > 0.5 ? d / (2 - max - min) : d / (max + min)

      switch (max) {
        case r:
          h = (g - b) / d + (g < b ? 6 : 0)
          break
        case g:
          h = (b - r) / d + 2
          break
        case b:
          h = (r - g) / d + 4
          break
      }

      h /= 6
    }

    return {
      h: Math.round(h * 360),
      s: Math.round(s * 100),
      l: Math.round(l * 100)
    }
  }

  const applyThemeColor = (color) => {
    const root = document.documentElement
    const { h, s, l } = hexToHsl(color)

    // 浅色模式保持用户选择的颜色，但避免极端颜色导致界面难以阅读
    const lightL = Math.min(65, Math.max(35, l))

    // 深色模式自动提高亮度，让主色在深色背景上仍然明显
    const darkL = Math.min(85, Math.max(65, l < 65 ? l + 25 : l))

    const lightPrimary = `${h} ${s}% ${lightL}%`
    const darkPrimary = `${h} ${s}% ${darkL}%`

    const lightForeground =
      lightL > 55 ? '240 5.9% 10%' : '0 0% 98%'

    const darkForeground =
      darkL > 60 ? '240 3.7% 15.9%' : '0 0% 98%'

    root.style.setProperty('--theme-primary-light', lightPrimary)
    root.style.setProperty('--theme-primary-dark', darkPrimary)
    root.style.setProperty(
      '--theme-primary-foreground-light',
      lightForeground
    )
    root.style.setProperty(
      '--theme-primary-foreground-dark',
      darkForeground
    )

    localStorage.setItem(THEME_COLOR_KEY, color)

    const icon = document.getElementById('themeColorIcon')
    if (icon instanceof HTMLElement) {
      icon.style.backgroundColor = color
    }

    document.querySelectorAll('[data-theme-color]').forEach((element) => {
      if (!(element instanceof HTMLElement)) return

      const selected =
        normalizeHex(element.dataset.themeColor || '') === normalizeHex(color)

      element.dataset.selected = selected.toString()
    })

    const input = document.getElementById('themeColorInput')

    if (input instanceof HTMLInputElement) {
      input.value = color
    }
  }

  try {
    const savedColor = normalizeHex(localStorage.getItem(THEME_COLOR_KEY) || '')
    const hasSavedColor = localStorage.getItem(THEME_COLOR_KEY)

    if (hasSavedColor) {
      applyThemeColor(savedColor)
    }
  } catch {
    // localStorage 不可用时继续使用默认主题色
  }
</script>

<div id='themeColorPicker' class='relative'>
  <button
    id='toggleThemeColor'
    type='button'
    class='box-content size-5 rounded-md border p-1.5 transition-colors hover:bg-border sm:group-[.not-top]:rounded-xl'
    aria-label='选择主题色'
    aria-expanded='false'
    title='主题色'
  >
    <span
      id='themeColorIcon'
      aria-hidden='true'
      class='block size-5 rounded-full border border-black/10 dark:border-white/10'
    ></span>
  </button>

  <div
    id='themeColorPanel'
    hidden
    class='absolute end-0 top-[calc(100%+0.5rem)] z-[80] w-48 rounded-xl border border-border bg-background p-3 text-foreground shadow-lg'
  >
    <div class='mb-3 text-sm font-medium'>主题色</div>

    <div class='grid grid-cols-6 gap-2'>
      {
        presets.map((preset) => (
          <button
            type='button'
            data-theme-color={preset.value}
            class='theme-color-swatch size-6 rounded-full border border-border transition-transform hover:scale-110'
            style={`background-color: ${preset.value}`}
            aria-label={preset.name}
            title={preset.name}
          />
        ))
      }
    </div>

    <div class='my-3 border-t border-border'></div>

    <label class='flex cursor-pointer items-center justify-between gap-3 text-sm'>
      <span>自定义</span>

      <input
        id='themeColorInput'
        type='color'
        value='#517E94'
        aria-label='自定义主题色'
        class='size-7 cursor-pointer rounded-md border-0 bg-transparent p-0'
      />
    </label>

    <button
      id='resetThemeColor'
      type='button'
      class='mt-3 w-full rounded-lg border border-border px-2 py-1.5 text-sm transition-colors hover:bg-muted'
    >
      恢复默认
    </button>
  </div>
</div>

<script>
  const picker = document.querySelector('#themeColorPicker')
  const toggleButton = document.querySelector('#toggleThemeColor')
  const panel = document.querySelector('#themeColorPanel')
  const colorInput = document.querySelector('#themeColorInput')
  const resetButton = document.querySelector('#resetThemeColor')

  if (
    picker instanceof HTMLElement &&
    toggleButton instanceof HTMLButtonElement &&
    panel instanceof HTMLDivElement &&
    colorInput instanceof HTMLInputElement &&
    resetButton instanceof HTMLButtonElement
  ) {
    const normalizeHex = (value: string) => {
      const hex = value.startsWith('#') ? value : `#${value}`

      return /^#[0-9a-fA-F]{6}$/.test(hex) ? hex.toUpperCase() : '#517E94'
    }

    const applyColor = (color: string) => {
      const root = document.documentElement

      const clean = normalizeHex(color)

      const r = Number.parseInt(clean.slice(1, 3), 16) / 255
      const g = Number.parseInt(clean.slice(3, 5), 16) / 255
      const b = Number.parseInt(clean.slice(5, 7), 16) / 255

      const max = Math.max(r, g, b)
      const min = Math.min(r, g, b)

      let h = 0
      let s = 0
      let l = (max + min) / 2

      if (max !== min) {
        const d = max - min

        s = l > 0.5 ? d / (2 - max - min) : d / (max + min)

        switch (max) {
          case r:
            h = (g - b) / d + (g < b ? 6 : 0)
            break
          case g:
            h = (b - r) / d + 2
            break
          default:
            h = (r - g) / d + 4
            break
        }

        h /= 6
      }

      const hue = Math.round(h * 360)
      const saturation = Math.round(s * 100)
      const lightness = Math.round(l * 100)

      const lightL = Math.min(65, Math.max(35, lightness))
      const darkL = Math.min(85, Math.max(65, lightness < 65 ? lightness + 25 : lightness))

      const lightPrimary = `${hue} ${saturation}% ${lightL}%`
      const darkPrimary = `${hue} ${saturation}% ${darkL}%`

      const lightForeground =
        lightL > 55 ? '240 5.9% 10%' : '0 0% 98%'

      const darkForeground =
        darkL > 60 ? '240 3.7% 15.9%' : '0 0% 98%'

      root.style.setProperty('--theme-primary-light', lightPrimary)
      root.style.setProperty('--theme-primary-dark', darkPrimary)
      root.style.setProperty(
        '--theme-primary-foreground-light',
        lightForeground
      )
      root.style.setProperty(
        '--theme-primary-foreground-dark',
        darkForeground
      )

      localStorage.setItem('theme-color', clean)

      const icon = document.querySelector('#themeColorIcon')

      if (icon instanceof HTMLElement) {
        icon.style.backgroundColor = clean
      }

      document.querySelectorAll('[data-theme-color]').forEach((element) => {
        if (!(element instanceof HTMLElement)) return

        element.dataset.selected = (
          normalizeHex(element.dataset.themeColor || '') === clean
        ).toString()
      })

      colorInput.value = clean
    }

    const savedColor = localStorage.getItem('theme-color')

    if (savedColor) {
      applyColor(savedColor)
    } else {
      applyColor('#517E94')
    }

    toggleButton.addEventListener('click', (event) => {
      event.stopPropagation()

      const open = !panel.hidden

      panel.hidden = open
      toggleButton.setAttribute('aria-expanded', (!open).toString())
    })

    panel.addEventListener('click', (event) => {
      event.stopPropagation()

      const target = event.target

      if (!(target instanceof HTMLElement)) return

      const swatch = target.closest('[data-theme-color]')

      if (swatch instanceof HTMLElement) {
        const color = swatch.dataset.themeColor

        if (color) {
          applyColor(color)
        }
      }
    })

    colorInput.addEventListener('input', () => {
      applyColor(colorInput.value)
    })

    resetButton.addEventListener('click', () => {
      localStorage.removeItem('theme-color')
      applyColor('#517E94')
    })

    document.addEventListener('pointerdown', (event) => {
      const target = event.target

      if (!(target instanceof Element)) return
      if (picker.contains(target)) return

      panel.hidden = true
      toggleButton.setAttribute('aria-expanded', 'false')
    })
  }
</script>

<style>
  #themeColorIcon {
    background-color: hsl(var(--primary));
    transition: background-color 0.2s ease;
  }

  .theme-color-swatch[data-selected='true'] {
    box-shadow:
      0 0 0 2px hsl(var(--background)),
      0 0 0 4px hsl(var(--primary));
  }
</style>