---
import type { Lang } from '@/i18n/ui'
import { dailyDateKey, dailyIssueHref, latestDailyEntries, type DailyEntry } from '@/lib/daily'

interface Props {
  entries: DailyEntry[]
  lang?: Lang
}
const { entries, lang = 'zh' } = Astro.props
const latest = latestDailyEntries(entries)
const labels = {
  zh: { title: '最新精选', all: '全部', github: 'GitHub 宝藏', ai: 'AI 情报', count: '项' },
  en: {
    title: 'Latest finds',
    all: 'All issues',
    github: 'GitHub finds',
    ai: 'AI briefing',
    count: 'items'
  }
}[lang]
---

{
  latest.length > 0 && (
    <section class='daily-preview' aria-labelledby='daily-preview-title'>
      <div class='daily-preview__heading'>
        <h2 id='daily-preview-title'>{labels.title}</h2>
        <a href={lang === 'en' ? '/en/curated' : '/curated'}>{labels.all} ↗</a>
      </div>
      <ul>
        {latest.map((entry) => (
          <li>
            <a href={dailyIssueHref(entry)}>
              <time datetime={dailyDateKey(entry.data.date)}>
                {dailyDateKey(entry.data.date).slice(5).replace('-', '/')}
              </time>
              <span class='daily-preview__category'>{labels[entry.data.category]}</span>
              <span class='daily-preview__headline'>{entry.data.headline}</span>
              <span class='daily-preview__count'>
                {entry.data.itemCount} {labels.count}
              </span>
              <span aria-hidden='true'>↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .daily-preview {
    margin-top: 1.4rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid hsl(var(--border));
  }
  .daily-preview__heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.4rem;
    font-size: 0.74rem;
  }
  .daily-preview__heading h2 {
    font-weight: 500;
  }
  .daily-preview__heading > a {
    color: hsl(var(--muted-foreground));
    font-size: 0.68rem;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li > a {
    display: grid;
    grid-template-columns: 3.1rem 6.5rem minmax(0, 1fr) auto 0.8rem;
    align-items: center;
    gap: 0.8rem;
    min-height: 2rem;
  }
  time,
  .daily-preview__count {
    color: hsl(var(--muted-foreground));
    font-size: 0.66rem;
    font-variant-numeric: tabular-nums;
  }
  .daily-preview__category {
    color: hsl(var(--primary));
    font-size: 0.7rem;
  }
  .daily-preview__headline {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.79rem;
  }
  li > a > span:last-child {
    color: hsl(var(--muted-foreground));
    font-size: 0.8rem;
  }
  @media (max-width: 640px) {
    li > a {
      grid-template-columns: 2.8rem 5.6rem minmax(0, 1fr) 0.7rem;
      gap: 0.45rem;
      min-height: 2.2rem;
    }
    .daily-preview__count {
      display: none;
    }
  }
</style>
