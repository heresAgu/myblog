---
import {
  getLangFromUrl,
  hasEnAlternate,
  localizedPath,
  useTranslations,
  type Lang
} from '@/i18n/ui'

import { Icon } from 'astro-pure/user'
import config from '@/site-config'

interface Props {
  lang?: Lang
}
const lang = (Astro.props.lang ?? getLangFromUrl(Astro.url)) as Lang
const t = useTranslations(lang)
const menuKeyMap: Record<string, Parameters<typeof t>[0]> = {
  '/': 'nav.home',
  '/blog': 'nav.blog',
  '/notes': 'nav.notes',
  '/projects': 'nav.projects',
  '/curated': 'nav.curated',
  '/about': 'nav.about'
}
const menu = (config.header?.menu ?? [])
  .filter((item) => lang !== 'en' || hasEnAlternate(item.link))
  .map((item) => ({
    title: menuKeyMap[item.link] ? t(menuKeyMap[item.link]) : item.title,
    link: localizedPath(item.link, lang)
  }))
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/'
const homeHref = localizedPath('/', lang)
---

<site-header class='site-header'>
  <nav
    id='header-menu'
    class='site-header__menu'
    aria-label={lang === 'en' ? 'Main navigation' : '主导航'}
  >
    {
      menu.map((item) => (
        <a
          href={item.link}
          aria-current={
            pathname === item.link ||
            (item.link !== homeHref && pathname.startsWith(item.link + '/'))
              ? 'page'
              : undefined
          }
        >
          {item.title}
        </a>
      ))
    }
  </nav>
  <div class='site-header__actions'>
    <a
      href={localizedPath('/search', lang)}
      class='header-icon'
      aria-label={t('nav.search')}
      title={t('nav.search')}><Icon name='search' class='size-4' /></a
    >
    <button
      type='button'
      id='toggleDarkMode'
      class='header-icon'
      aria-label={t('nav.toggleDarkMode')}
      title={t('nav.toggleDarkMode')}
    >
      <Icon name='sun' class='theme-sun size-4' /><Icon name='moon' class='theme-moon size-4' />
    </button>
    <button
      type='button'
      class='header-icon header-menu-toggle'
      aria-label={t('nav.toggleMenu')}
      aria-controls='header-menu'
      aria-expanded='false'
    >
      <Icon name='menu' class='size-5' />
    </button>
  </div>
  <a
    class='site-header__brand'
    href={homeHref}
    aria-label={`${config.title} — ${lang === 'en' ? 'Home' : '主页'}`}>{config.title}</a
  >
</site-header>

<script>
  class SiteHeader extends HTMLElement {
    private controller?: AbortController

    connectedCallback() {
      this.controller?.abort()
      this.controller = new AbortController()
      const options = { signal: this.controller.signal }
      const menuButton = this.querySelector<HTMLButtonElement>('.header-menu-toggle')
      const close = () => {
        this.removeAttribute('data-expanded')
        menuButton?.setAttribute('aria-expanded', 'false')
      }
      menuButton?.addEventListener(
        'click',
        () => {
          const expanded = this.getAttribute('data-expanded') !== 'true'
          this.setAttribute('data-expanded', String(expanded))
          menuButton.setAttribute('aria-expanded', String(expanded))
        },
        options
      )
      document.addEventListener(
        'pointerdown',
        (event) => {
          if (event.target instanceof Node && !this.contains(event.target)) close()
        },
        options
      )
      document.addEventListener(
        'keydown',
        (event) => {
          if (event.key === 'Escape' && this.getAttribute('data-expanded') === 'true') {
            close()
            menuButton?.focus()
          }
        },
        options
      )
      this.querySelector('nav')?.addEventListener(
        'click',
        (event) => {
          if (event.target instanceof Element && event.target.closest('a')) close()
        },
        options
      )
      this.querySelector('#toggleDarkMode')?.addEventListener(
        'click',
        () => {
          const theme = document.documentElement.classList.contains('dark') ? 'light' : 'dark'
          document.documentElement.classList.toggle('dark', theme === 'dark')
          try {
            localStorage.setItem('theme', theme)
          } catch {}
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute('content', theme === 'dark' ? '#1A1E24' : '#F7F8FA')
        },
        options
      )
    }

    disconnectedCallback() {
      this.controller?.abort()
    }
  }
  if (!customElements.get('site-header')) customElements.define('site-header', SiteHeader)
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 70;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    column-gap: 2rem;
    align-items: center;
    min-height: 5.7rem;
    margin: 0 auto 1.2rem;
    border-bottom: 1px solid hsl(var(--border));
    background: hsl(var(--background) / 0.95);
    backdrop-filter: blur(14px);
  }
  .site-header__brand {
    justify-self: end;
    font-family: var(--font-literary);
    font-size: 1.9rem;
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .site-header__menu {
    display: flex;
    align-items: center;
    gap: 2.2rem;
  }
  .site-header__menu > a {
    position: relative;
    padding: 0.6rem 0;
    font-size: 0.82rem;
    color: hsl(var(--muted-foreground));
    letter-spacing: 0.03em;
  }
  .site-header__menu > a:hover,
  .site-header__menu > a[aria-current] {
    color: hsl(var(--foreground));
  }
  .site-header__menu > a[aria-current]::after {
    content: '';
    position: absolute;
    width: 4px;
    height: 4px;
    left: calc(50% - 2px);
    bottom: 0;
    border-radius: 50%;
    background: hsl(var(--primary));
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 0.45rem;
  }
  .header-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.3rem;
    height: 2.3rem;
    background: transparent;
    border: 0;
    color: hsl(var(--muted-foreground));
    cursor: pointer;
    transition: color 0.2s;
  }
  .header-icon:hover {
    color: hsl(var(--primary));
  }
  .theme-moon {
    display: none;
  }
  :global(.dark) .theme-moon {
    display: block;
  }
  :global(.dark) .theme-sun {
    display: none;
  }
  .header-menu-toggle {
    display: none;
  }
  @media (max-width: 640px) {
    .site-header {
      grid-template-columns: 1fr auto;
      min-height: 4.6rem;
      margin-bottom: 0.7rem;
    }
    .site-header__brand {
      font-size: 1.75rem;
    }
    .site-header__actions {
      justify-self: start;
    }
    .header-menu-toggle {
      display: inline-flex;
      order: -1;
    }
    .site-header__menu {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      padding: 1rem 0 1.3rem;
      background: hsl(var(--background));
      border-bottom: 1px solid hsl(var(--border));
      gap: 0.5rem;
    }
    .site-header[data-expanded='true'] .site-header__menu {
      display: flex;
      flex-direction: column;
      align-items: stretch;
    }
    .site-header__menu > a {
      padding: 0.8rem 0.5rem;
    }
    .site-header__menu > a[aria-current]::after {
      left: auto;
      right: 0.8rem;
      bottom: calc(50% - 2px);
    }
  }
</style>
