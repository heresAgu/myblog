---
import { Image } from 'astro:assets'
import { tablensProject } from '@/data/projects'
import type { Lang } from '@/i18n/ui'

import PageLayout from '@/layouts/BaseLayout.astro'
import tablensPreview from '@/assets/projects/tablens-workspace.png'

const { lang = 'zh' } = Astro.props as { lang?: Lang }
const en = lang === 'en'
---

<PageLayout meta={{ title: 'TabLens', description: tablensProject.summary[lang] }}>
  <main class='project-detail index-page'>
    <a class='project-detail__back' href={en ? '/en/projects' : '/projects'}
      >← {en ? 'All projects' : '全部项目'}</a
    >
    <header class='project-detail__header'>
      <div>
        <p class='eyebrow'>{en ? 'PERSONAL TOOL / GUITAR TAB' : '个人工具 / 吉他六线谱'}</p><h1>
          TabLens
        </h1><p class='project-detail__subtitle'>{tablensProject.subtitle[lang]}</p>
      </div>
      <div class='project-detail__links'>
        <a
          class='text-link'
          href={tablensProject.href}
          target='_blank'
          rel='noopener noreferrer'
          data-analytics-event='project_link_click'
          data-analytics-surface='project-detail'
          data-analytics-project='tablens'
          data-analytics-link-type='github'>GitHub <span aria-hidden='true'>↗</span></a
        >
        <a
          class='quiet-link'
          href={tablensProject.guideHref}
          target='_blank'
          rel='noopener noreferrer'
          data-analytics-event='project_link_click'
          data-analytics-surface='project-detail'
          data-analytics-project='tablens'
          data-analytics-link-type='doc'
          >{en ? 'User guide' : '使用手册'} <span aria-hidden='true'>↗</span></a
        >
      </div>
    </header>
    <p class='project-detail__intro'>{tablensProject.description[lang]}</p>
    <figure class='project-detail__preview'>
      <Image
        src={tablensPreview}
        alt={en
          ? 'The real TabLens workspace with a demonstration guitar score'
          : 'TabLens 真实工作台，展示演示练习谱、播放控制与音符编辑'}
        widths={[600, 1024, 1440]}
        sizes='(max-width: 1024px) calc(100vw - 32px), 1024px'
        format='webp'
        loading='eager'
      />
      <figcaption>
        {
          en
            ? 'The real workspace, using a demonstration practice score.'
            : '真实工作台界面，使用演示练习谱。'
        }
      </figcaption>
    </figure>
    <section class='project-detail__features' aria-label={en ? 'Workflow' : '使用流程'}>
      {
        tablensProject.features.map((feature, index) => (
          <article>
            <>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h2>{feature.title[lang]}</h2>
              <p>{feature.description[lang]}</p>
            </>
          </article>
        ))
      }
    </section>
    <div class='project-detail__notes'>
      <p>{tablensProject.usage[lang]}</p><p>{tablensProject.technologies.join(' / ')}</p>
    </div>
  </main>
</PageLayout>

<style>
  .project-detail {
    padding-top: 2rem;
  }
  .project-detail__back {
    font-size: 0.76rem;
    color: hsl(var(--muted-foreground));
  }
  .project-detail__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-top: 2.5rem;
  }
  .project-detail h1 {
    margin-top: 0.65rem;
    font: 400 clamp(3rem, 6vw, 4.5rem) / 1.1 var(--font-literary);
    letter-spacing: -0.045em;
  }
  .project-detail__subtitle {
    margin-top: 0.85rem;
    font-size: 1rem;
  }
  .project-detail__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.8rem;
    padding-bottom: 0.2rem;
  }
  .project-detail__intro {
    max-width: 43rem;
    margin: 1.7rem 0 2.2rem;
    font-size: 0.88rem;
    line-height: 1.95;
    color: hsl(var(--muted-foreground));
  }
  .project-detail__preview {
    margin: 0;
  }
  .project-detail__preview img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid hsl(var(--border));
  }
  .project-detail__preview figcaption {
    margin-top: 0.75rem;
    font-size: 0.7rem;
    color: hsl(var(--muted-foreground));
  }
  .project-detail__features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
    margin-top: 2.6rem;
  }
  .project-detail__features article {
    padding-top: 1rem;
    border-top: 1px solid hsl(var(--border));
  }
  .project-detail__features article > span {
    font: 0.65rem var(--font-mono);
    color: hsl(var(--primary));
  }
  .project-detail__features h2 {
    margin-top: 0.8rem;
    font: 500 1.15rem/1.6 var(--font-serif);
  }
  .project-detail__features p {
    margin-top: 0.6rem;
    font-size: 0.83rem;
    line-height: 1.9;
    color: hsl(var(--muted-foreground));
  }
  .project-detail__notes {
    margin-top: 2.6rem;
    padding-top: 1.3rem;
    border-top: 1px solid hsl(var(--border));
    font-size: 0.76rem;
    line-height: 1.9;
    color: hsl(var(--muted-foreground));
  }
  .project-detail__notes p + p {
    margin-top: 0.7rem;
    font: 0.65rem/1.9 var(--font-mono);
  }
  @media (max-width: 680px) {
    .project-detail__header {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.4rem;
    }
    .project-detail__features {
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }
  }
</style>
