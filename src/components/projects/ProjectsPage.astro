---
import { Image } from 'astro:assets'
import { learningProjects, personalProjects, tablensProject } from '@/data/projects'
import type { Lang } from '@/i18n/ui'

import PageLayout from '@/layouts/BaseLayout.astro'
import GitHubContributions from '@/components/projects/GitHubContributions.astro'
import tablensPreview from '@/assets/projects/tablens-workspace.png'

const { lang = 'zh' } = Astro.props as { lang?: Lang }
const en = lang === 'en'
const detailHref = en ? '/en/projects/tablens' : '/projects/tablens'
const copy = {
  title: en ? 'Projects' : '项目',
  description: en
    ? 'Personal tools, experiments, and things I’m learning by building.'
    : '个人工具，以及学习过程中留下的实现与实验。',
  detail: en ? 'Explore project' : '查看项目',
  preview: en ? 'The TabLens workspace · Demo score' : 'TabLens 工作台 · 演示练习谱',
  featured: en ? 'PERSONAL TOOL' : '个人工具',
  tools: en ? 'More tools' : '更多工具',
  learning: en ? 'Learning & implementations' : '学习与实现',
  activity: en ? 'GitHub activity' : 'GitHub 动态',
  expand: en ? 'Show' : '展开',
  collapse: en ? 'Hide' : '收起'
}
const groups = [
  { id: 'tools', title: copy.tools, projects: personalProjects, offset: 2 },
  {
    id: 'learning',
    title: copy.learning,
    projects: learningProjects,
    offset: 2 + personalProjects.length
  }
]
function analyticsAttrs(
  project: string,
  linkType: 'github' | 'detail',
  section: string = 'featured'
) {
  return {
    'data-analytics-event': 'project_link_click',
    'data-analytics-surface': 'projects',
    'data-analytics-section': section,
    'data-analytics-project': project,
    'data-analytics-link-type': linkType
  }
}
---

<PageLayout meta={{ title: copy.title, description: copy.description }}>
  <main class='index-page projects-page'>
    <header class='projects-heading'>
      <div><h1>{copy.title}</h1><p>{copy.description}</p></div>
      <span class='projects-count'
        >{String(1 + personalProjects.length + learningProjects.length).padStart(2, '0')} / PROJECTS</span
      >
    </header>
    <article class='project-feature' aria-labelledby='tablens-title'>
      <a
        class='project-preview'
        href={detailHref}
        aria-label={`${copy.detail} · TabLens`}
        {...analyticsAttrs('tablens', 'detail')}
      >
        <figure>
          <div class='project-preview__image'>
            <Image
              src={tablensPreview}
              alt={en
                ? 'TabLens showing an editable guitar TAB score and note controls'
                : 'TabLens 真实工作台中的六线谱、播放控制与音符编辑界面'}
              widths={[600, 960, 1440]}
              sizes='(max-width: 760px) calc(100vw - 32px), 60vw'
              format='webp'
              loading='eager'
            />
          </div>
          <figcaption><span>{copy.preview}</span><span aria-hidden='true'>↗</span></figcaption>
        </figure>
      </a>
      <div class='project-feature__copy'>
        <p class='project-kicker'><span>01</span> {copy.featured}</p>
        <h2 id='tablens-title'><a href={detailHref}>{tablensProject.name}</a></h2>
        <p class='project-subtitle'>{tablensProject.subtitle[lang]}</p>
        <p class='project-summary'>{tablensProject.summary[lang]}</p>
        <ul class='project-capabilities' aria-label={en ? 'Features' : '主要功能'}>
          {tablensProject.features.map((feature) => <li>{feature.title[lang]}</li>)}
        </ul>
        <p class='project-technologies'>{tablensProject.technologies.join(' / ')}</p>
        <div class='project-links'>
          <a class='text-link' href={detailHref} {...analyticsAttrs('tablens', 'detail')}
            >{copy.detail}<span aria-hidden='true'>↗</span></a
          >
          <a
            class='quiet-link'
            href={tablensProject.href}
            target='_blank'
            rel='noopener noreferrer'
            {...analyticsAttrs('tablens', 'github')}>GitHub<span aria-hidden='true'>↗</span></a
          >
        </div>
      </div>
    </article>
    {
      groups.map((group) => (
        <section class='project-group' aria-labelledby={`projects-${group.id}`}>
          <div class='project-group__heading'>
            <>
              <h2 id={`projects-${group.id}`}>{group.title}</h2>
              <span>{String(group.projects.length).padStart(2, '0')}</span>
            </>
          </div>
          <ul class='project-rows'>
            {group.projects.map((project, index) => (
              <li>
                <a
                  class='project-row'
                  href={project.href}
                  target='_blank'
                  rel='noopener noreferrer'
                  {...analyticsAttrs(project.id, 'github', group.id)}
                >
                  <span class='project-row__number' aria-hidden='true'>
                    {String(index + group.offset).padStart(2, '0')}
                  </span>
                  <div class='project-row__copy'>
                    <h3>{project.name[lang]}</h3>
                    <p>{project.description[lang]}</p>
                  </div>
                  <span class='project-row__stack'>{project.technologies.join(' · ')}</span>
                  <span class='project-row__arrow' aria-hidden='true'>
                    ↗
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
    <details class='projects-activity'>
      <summary
        ><span>{copy.activity}</span><span class='projects-activity__toggle'
          ><span class='when-closed'>{copy.expand}</span><span class='when-open'
            >{copy.collapse}</span
          >
          <span aria-hidden='true'>↘</span></span
        ></summary
      >
      <div class='projects-activity__content'><GitHubContributions username='heresAgu' /></div>
    </details>
  </main>
</PageLayout>

<style>
  .projects-page {
    padding-top: 2.3rem;
  }
  .projects-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 1.8rem;
  }
  .projects-heading h1 {
    font: 500 clamp(1.8rem, 3vw, 2.3rem) / 1.4 var(--font-serif);
    letter-spacing: -0.03em;
  }
  .projects-heading p {
    margin-top: 0.55rem;
    font-size: 0.85rem;
    line-height: 1.8;
    color: hsl(var(--muted-foreground));
  }
  .projects-count {
    padding-bottom: 0.2rem;
    font: 0.6rem var(--font-mono);
    letter-spacing: 0.05em;
    color: hsl(var(--muted-foreground));
    white-space: nowrap;
  }
  .project-feature {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 2.8rem;
    align-items: center;
    padding: 1.8rem 0 2.2rem;
    border-block: 1px solid hsl(var(--border));
  }
  .project-preview {
    display: block;
    min-width: 0;
  }
  .project-preview__image {
    padding: 0.75rem;
    background: hsl(var(--muted));
    border: 1px solid hsl(var(--border) / 0.6);
    overflow: hidden;
  }
  .project-preview img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.4s ease;
  }
  .project-preview:hover img {
    transform: scale(1.018);
  }
  .project-preview figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.7rem;
    font-size: 0.65rem;
    color: hsl(var(--muted-foreground));
  }
  .project-kicker {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 0.65rem;
    color: hsl(var(--muted-foreground));
  }
  .project-kicker > span {
    font-family: var(--font-mono);
    color: hsl(var(--primary));
  }
  .project-feature h2 {
    margin-top: 0.9rem;
    font: 400 clamp(2.4rem, 4vw, 3.2rem) / 1.1 var(--font-literary);
    letter-spacing: -0.045em;
  }
  .project-subtitle {
    margin-top: 0.75rem;
    font-size: 0.92rem;
    line-height: 1.75;
  }
  .project-summary {
    margin-top: 0.8rem;
    font-size: 0.8rem;
    line-height: 1.9;
    color: hsl(var(--muted-foreground));
  }
  .project-capabilities {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.8rem;
    list-style: none;
    padding: 0;
    margin-top: 1.05rem;
    font-size: 0.69rem;
    color: hsl(var(--primary));
  }
  .project-capabilities li + li::before {
    content: '·';
    margin-right: 0.8rem;
    color: hsl(var(--muted-foreground));
  }
  .project-technologies {
    margin-top: 0.8rem;
    font: 0.6rem/1.8 var(--font-mono);
    color: hsl(var(--muted-foreground));
  }
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
    margin-top: 1.5rem;
  }
  .project-links a {
    font-size: 0.78rem;
  }
  .project-group {
    margin-top: 2.3rem;
  }
  .project-group__heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid hsl(var(--border));
  }
  .project-group__heading h2 {
    font: 500 1rem/1.7 var(--font-serif);
  }
  .project-group__heading > span {
    font: 0.6rem var(--font-mono);
    color: hsl(var(--muted-foreground));
  }
  .project-rows {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .project-rows li {
    border-bottom: 1px solid hsl(var(--border) / 0.65);
  }
  .project-row {
    display: grid;
    grid-template-columns: 1.6rem minmax(0, 1fr) auto 1rem;
    gap: 1.1rem;
    align-items: center;
    padding: 1.15rem 0;
  }
  .project-row__number {
    align-self: baseline;
    padding-top: 0.3rem;
    font: 0.62rem var(--font-mono);
    color: hsl(var(--muted-foreground));
  }
  .project-row h3 {
    font: 500 1.02rem/1.6 var(--font-serif);
  }
  .project-row p {
    margin-top: 0.25rem;
    font-size: 0.77rem;
    line-height: 1.8;
    color: hsl(var(--muted-foreground));
  }
  .project-row__stack {
    font: 0.58rem/1.8 var(--font-mono);
    color: hsl(var(--muted-foreground));
  }
  .project-row__arrow {
    color: hsl(var(--muted-foreground));
    transition: transform 0.2s ease;
  }
  .project-row:hover .project-row__arrow {
    transform: translate(2px, -2px);
  }
  .projects-activity {
    margin-top: 2.5rem;
    border-bottom: 1px solid hsl(var(--border));
  }
  .projects-activity summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 0;
    font-size: 0.78rem;
    cursor: pointer;
    list-style: none;
  }
  .projects-activity summary::-webkit-details-marker {
    display: none;
  }
  .projects-activity__toggle {
    display: flex;
    gap: 0.7rem;
    font-size: 0.68rem;
    color: hsl(var(--muted-foreground));
  }
  .projects-activity .when-open,
  .projects-activity[open] .when-closed {
    display: none;
  }
  .projects-activity[open] .when-open {
    display: inline;
  }
  .projects-activity__content {
    padding: 0.75rem 0 1.75rem;
  }
  @media (max-width: 760px) {
    .project-feature {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.6rem;
    }
    .project-feature__copy {
      padding-bottom: 0.3rem;
    }
    .project-row {
      grid-template-columns: 1.4rem minmax(0, 1fr) 1rem;
      gap: 0.25rem 0.7rem;
    }
    .project-row__stack {
      grid-column: 2;
      grid-row: 2;
      margin-top: 0.25rem;
    }
    .project-row__arrow {
      grid-column: 3;
      grid-row: 1;
      align-self: start;
      padding-top: 0.3rem;
    }
    .projects-count {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .project-preview img,
    .project-row__arrow {
      transition: none;
    }
  }
</style>
