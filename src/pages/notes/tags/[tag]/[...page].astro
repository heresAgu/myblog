---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'

import { Paginator } from 'astro-pure/components/pages'
import PageLayout from '@/layouts/BaseLayout.astro'
import EntryRow from '@/components/EntryRow.astro'

export const prerender = true
export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const notes = (await getCollection('notes')).filter((entry) => !entry.data.draft)
  const tags = [...new Set(notes.flatMap((entry) => entry.data.tags))]
  return tags.flatMap((tag) =>
    paginate(
      notes
        .filter((entry) => entry.data.tags.includes(tag))
        .sort(
          (a, b) =>
            +(b.data.updatedDate ?? b.data.date) - +(a.data.updatedDate ?? a.data.date) ||
            (a.data.order ?? Infinity) - (b.data.order ?? Infinity) ||
            a.id.localeCompare(b.id)
        ),
      { params: { tag }, pageSize: 10 }
    )
  )
}
interface Props {
  page: Page<CollectionEntry<'notes'>>
}
const { page } = Astro.props
const { tag } = Astro.params
const meta = { title: `笔记标签：${tag}`, description: `查看带有「${tag}」标签的笔记` }
const paginationProps = {
  ...(page.url.prev && { prevUrl: { text: '← 上一页', url: page.url.prev } }),
  ...(page.url.next && { nextUrl: { text: '下一页 →', url: page.url.next } })
}
---

<PageLayout {meta}>
  <main class='index-page'>
    <header class='page-masthead' id='content-header'>
      <p class='eyebrow'><a href='/notes'>笔记</a> / BY SUBJECT</p>
      <h1>{tag}<em>Index.</em></h1>
      <p>沿着「{tag}」这条线索，找到 {page.total} 篇笔记。</p>
    </header>
    <section id='content' aria-label='笔记列表'>
      <ul class='entry-list'>
        {
          page.data.map((entry) => (
            <EntryRow
              href={`/notes/${entry.id}`}
              title={entry.data.title}
              description={entry.data.description}
              date={entry.data.updatedDate ?? entry.data.date}
              category={entry.data.tags.filter((t) => t !== tag).join(' / ')}
            />
          ))
        }
      </ul>
      {
        page.lastPage > 1 && (
          <div class='mt-8'>
            <Paginator {...paginationProps} />
          </div>
        )
      }
    </section>
  </main>
</PageLayout>
