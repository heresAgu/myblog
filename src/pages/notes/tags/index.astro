---
import { getCollection } from 'astro:content'

import PageLayout from '@/layouts/BaseLayout.astro'

export const prerender = true
const notes = (await getCollection('notes')).filter((entry) => !entry.data.draft)
const counts = new Map<string, number>()
notes.forEach((entry) =>
  entry.data.tags.forEach((tag) => counts.set(tag, (counts.get(tag) ?? 0) + 1))
)
const tags = [...counts].sort(([a, ac], [b, bc]) => bc - ac || a.localeCompare(b))
---

<PageLayout meta={{ title: '笔记主题索引', description: '沿着主题，寻找学习笔记。' }}>
  <main class='index-page'>
    <header class='page-masthead' id='content-header'>
      <p class='eyebrow'><a href='/notes'>笔记</a> / SUBJECT INDEX</p>
      <h1>主题索引<em>Find a thread.</em></h1>
      <p>{tags.length} 个主题，{notes.length} 篇笔记。挑一个感兴趣的词，继续读下去。</p>
    </header>
    <ul class='entry-list'>
      {
        tags.map(([tag, count], index) => (
          <li class='entry-row entry-row--compact'>
            <a href={`/notes/tags/${tag}`}>
              <span class='entry-row__index'>{String(index + 1).padStart(2, '0')}</span>
              <div class='entry-row__body'>
                <>
                  <h3>{tag}</h3>
                  <p>{count} 篇笔记</p>
                </>
              </div>
              <span class='entry-row__arrow' aria-hidden='true'>
                ↗
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</PageLayout>
