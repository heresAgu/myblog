---
import { getCollection } from 'astro:content'

import PageLayout from '@/layouts/BaseLayout.astro'
import EntryRow from '@/components/EntryRow.astro'

export const prerender = true

const notes = (await getCollection('notes'))
  .filter((entry) => !entry.data.draft && entry.data.tags.includes('csapp'))
  .sort((a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity))

const chapters = [
  {
    number: '02',
    title: '信息的表示和处理',
    description: '从位与字节出发，理解整数和浮点数怎样存储、解释与运算。',
    tag: '信息的表示'
  },
  {
    number: '03',
    title: '程序的机器级表示',
    description: '沿着 C 代码到汇编的路径，理解指令、控制流、函数调用、数据布局与内存安全。',
    tag: '机器级程序'
  }
]
  .map((chapter) => ({
    ...chapter,
    id: `chapter-${chapter.number}`,
    entries: notes.filter((entry) => entry.data.tags.includes(chapter.tag))
  }))
  .filter((chapter) => chapter.entries.length > 0)

const meta = {
  title: 'CSAPP 学习笔记',
  description: '按章节与阅读顺序整理的《深入理解计算机系统》学习笔记。'
}
---

<PageLayout {meta}>
  <main class='index-page series-index'>
    <header class='series-header' id='content-header'>
      <p class='eyebrow'><a href='/notes'>笔记</a> / CSAPP</p>
      <h1>CSAPP 学习笔记<span>{notes.length} 篇</span></h1>
      <p>《深入理解计算机系统》· 按章节阅读</p>
    </header>

    <note-chapter-index class='series-layout'>
      <div class='series-mobile-nav'>
        <label for='series-chapter-select'>章节</label>
        <select id='series-chapter-select' aria-controls='series-chapters'>
          {
            chapters.map((chapter) => (
              <option value={chapter.id}>
                第 {Number(chapter.number)} 章 · {chapter.title}
              </option>
            ))
          }
        </select>
        <noscript>
          <nav aria-label='章节跳转'>
            {
              chapters.map((chapter) => (
                <a href={`#${chapter.id}`}>第 {Number(chapter.number)} 章</a>
              ))
            }
          </nav>
        </noscript>
      </div>

      <aside class='series-sidebar' aria-label='章节目录'>
        <nav>
          <p class='series-sidebar__label'>章节目录</p>
          {
            chapters.map((chapter, index) => (
              <a
                href={`#${chapter.id}`}
                data-chapter-link
                aria-current={index === 0 ? 'location' : undefined}
              >
                <span class='series-sidebar__number'>{chapter.number}</span>
                <span>
                  {chapter.title}
                  <small>{chapter.entries.length} 篇</small>
                </span>
              </a>
            ))
          }
        </nav>
      </aside>

      <div class='series-chapters' id='series-chapters'>
        {
          chapters.map((chapter) => (
            <section
              class='series-chapter'
              id={chapter.id}
              data-chapter
              aria-labelledby={`${chapter.id}-title`}
            >
              <header class='series-chapter__heading'>
                <h2 id={`${chapter.id}-title`}>
                  第 {Number(chapter.number)} 章 · {chapter.title}
                </h2>
                <span>{chapter.entries.length} 篇</span>
              </header>
              <p class='series-chapter__description'>{chapter.description}</p>
              <ol class='entry-list series-entries' aria-label={`${chapter.title}的笔记`}>
                {chapter.entries.map((entry) => (
                  <EntryRow
                    href={`/notes/${entry.id}`}
                    index={String(entry.data.order ?? '').padStart(2, '0')}
                    title={entry.data.title}
                    compact
                  />
                ))}
              </ol>
            </section>
          ))
        }
      </div>
    </note-chapter-index>
  </main>
</PageLayout>

<script>
  class NoteChapterIndex extends HTMLElement {
    private controller?: AbortController
    private frame = 0

    connectedCallback() {
      this.controller?.abort()
      this.controller = new AbortController()
      const options = { signal: this.controller.signal }
      const chapters = Array.from(this.querySelectorAll<HTMLElement>('[data-chapter]'))
      const links = Array.from(this.querySelectorAll<HTMLAnchorElement>('[data-chapter-link]'))
      const select = this.querySelector<HTMLSelectElement>('#series-chapter-select')
      const mobileNav = this.querySelector<HTMLElement>('.series-mobile-nav')
      if (!chapters.length) return

      const setActive = (id: string) => {
        links.forEach((link) => {
          if (link.hash === `#${id}`) link.setAttribute('aria-current', 'location')
          else link.removeAttribute('aria-current')
        })
        if (select) select.value = id
      }

      const update = () => {
        this.frame = 0
        const header = document.querySelector('site-header')?.getBoundingClientRect().height ?? 0
        const mobileHeight = mobileNav?.getBoundingClientRect().height ?? 0
        const scrollPadding =
          parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0
        const scrollMargin = parseFloat(getComputedStyle(chapters[0]).scrollMarginTop) || 0
        const offset = Math.max(header + mobileHeight + 16, scrollPadding + scrollMargin) + 4
        let active = chapters[0]
        for (const chapter of chapters) {
          if (chapter.getBoundingClientRect().top <= offset) active = chapter
        }
        if (
          window.scrollY > 0 &&
          window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2
        ) {
          active = chapters[chapters.length - 1]
        }
        setActive(active.id)
      }

      const scheduleUpdate = () => {
        if (!this.frame) this.frame = requestAnimationFrame(update)
      }
      select?.addEventListener(
        'change',
        () => {
          const chapter = chapters.find((item) => item.id === select.value)
          if (!chapter) return
          if (location.hash === `#${chapter.id}`) chapter.scrollIntoView({ block: 'start' })
          else location.hash = chapter.id
          setActive(chapter.id)
        },
        options
      )
      window.addEventListener('scroll', scheduleUpdate, { ...options, passive: true })
      window.addEventListener('resize', scheduleUpdate, options)
      window.addEventListener('hashchange', scheduleUpdate, options)
      window.addEventListener('load', scheduleUpdate, { ...options, once: true })
      scheduleUpdate()
    }

    disconnectedCallback() {
      this.controller?.abort()
      cancelAnimationFrame(this.frame)
      this.frame = 0
    }
  }

  if (!customElements.get('note-chapter-index')) {
    customElements.define('note-chapter-index', NoteChapterIndex)
  }
</script>

<style>
  .series-index {
    padding-top: 1.1rem;
  }
  .series-header {
    margin-bottom: 2.1rem;
  }
  .series-header h1 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1rem;
    margin: 0.65rem 0 0.4rem;
    font-family: var(--font-serif);
    font-size: 1.9rem;
    font-weight: 500;
    letter-spacing: -0.025em;
  }
  .series-header h1 > span {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0;
    color: hsl(var(--muted-foreground));
  }
  .series-header > p:last-child {
    color: hsl(var(--muted-foreground));
    font-size: 0.82rem;
    line-height: 1.8;
  }
  .series-layout {
    display: grid;
    grid-template-columns: 10.5rem minmax(0, 1fr);
    align-items: start;
    column-gap: 2.7rem;
  }
  .series-sidebar {
    position: sticky;
    top: 7.5rem;
  }
  .series-sidebar__label {
    margin-bottom: 0.9rem;
    padding-left: 0.7rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }
  .series-sidebar a {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    gap: 0.55rem;
    padding: 0.65rem 0.65rem;
    border-left: 1px solid hsl(var(--border));
    color: hsl(var(--muted-foreground));
    font-size: 0.81rem;
    line-height: 1.7;
  }
  .series-sidebar a[aria-current='location'] {
    border-left-color: hsl(var(--primary));
    color: hsl(var(--foreground));
  }
  .series-sidebar__number {
    font-size: 0.68rem;
    line-height: 2;
    color: hsl(var(--primary));
  }
  .series-sidebar small {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.65rem;
    color: hsl(var(--muted-foreground));
  }
  .series-mobile-nav {
    display: none;
  }
  .series-chapters {
    min-width: 0;
  }
  .series-chapter {
    scroll-margin-top: 1rem;
  }
  .series-chapter + .series-chapter {
    margin-top: 2.1rem;
  }
  .series-chapter__heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.9rem;
    border-top: 1px solid hsl(var(--border));
  }
  .series-chapter__heading h2 {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.8;
  }
  .series-chapter__heading > span {
    flex-shrink: 0;
    font-size: 0.7rem;
    color: hsl(var(--muted-foreground));
  }
  .series-chapter__description {
    margin: 0.3rem 0 0.75rem;
    font-size: 0.77rem;
    line-height: 1.8;
    color: hsl(var(--muted-foreground));
  }
  .series-entries :global(.entry-row > a) {
    grid-template-columns: 1.8rem minmax(0, 1fr) 1.1rem;
    align-items: baseline;
    min-height: 3rem;
    gap: 0.7rem;
    padding: 0.65rem 0;
  }
  .series-entries :global(.entry-row h3) {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.65;
  }
  .series-entries :global(.entry-row__index) {
    font-size: 0.7rem;
  }
  .series-entries :global(.entry-row__arrow) {
    font-size: 0.9rem;
  }
  @media (max-width: 800px) {
    .series-header {
      margin-bottom: 1.3rem;
    }
    .series-layout {
      display: block;
    }
    .series-sidebar {
      display: none;
    }
    .series-mobile-nav {
      position: sticky;
      top: 5.7rem;
      z-index: 30;
      display: flex;
      align-items: center;
      gap: 0.9rem;
      margin-bottom: 1.2rem;
      padding: 0.8rem 0;
      border-block: 1px solid hsl(var(--border));
      background: hsl(var(--background));
      font-size: 0.78rem;
    }
    .series-mobile-nav label {
      flex-shrink: 0;
      color: hsl(var(--muted-foreground));
    }
    .series-mobile-nav select {
      width: 100%;
      min-width: 0;
      min-height: 2rem;
      padding: 0.2rem 1.5rem 0.2rem 0.3rem;
      background-color: hsl(var(--background));
      color: hsl(var(--foreground));
      font-family: var(--font-sans);
      font-size: 0.8rem;
      cursor: pointer;
    }
    .series-mobile-nav noscript {
      flex-shrink: 0;
    }
    .series-mobile-nav noscript a {
      padding-inline: 0.3rem;
    }
    .series-chapter {
      scroll-margin-top: 3.5rem;
    }
  }
  @media (max-width: 640px) {
    .series-index {
      padding-top: 0.7rem;
    }
    .series-header h1 {
      gap: 0.7rem;
      font-size: 1.75rem;
    }
    .series-mobile-nav {
      top: 4.6rem;
    }
    .series-chapter {
      scroll-margin-top: 2rem;
    }
    .series-chapter + .series-chapter {
      margin-top: 1.6rem;
    }
    .series-chapter__heading h2 {
      font-size: 0.94rem;
    }
    .series-entries :global(.entry-row > a) {
      grid-template-columns: 1.5rem minmax(0, 1fr) 0.9rem;
      gap: 0.55rem;
      padding-block: 0.75rem;
    }
    .series-entries :global(.entry-row h3) {
      font-size: 0.94rem;
      line-height: 1.7;
    }
  }
</style>
