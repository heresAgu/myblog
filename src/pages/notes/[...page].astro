---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'
import { getNoteTopics } from '@/data/note-topics'

import { Paginator } from 'astro-pure/components/pages'
import PageLayout from '@/layouts/BaseLayout.astro'
import EntryRow from '@/components/EntryRow.astro'
import NoteTopicIndex from '@/components/notes/NoteTopicIndex.astro'

export const prerender = true

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const notes = (await getCollection('notes'))
    .filter((entry) => !entry.data.draft)
    .sort(
      (a, b) =>
        +(b.data.updatedDate ?? b.data.date) - +(a.data.updatedDate ?? a.data.date) ||
        (a.data.order ?? Infinity) - (b.data.order ?? Infinity) ||
        a.id.localeCompare(b.id)
    )
  return paginate(notes, { pageSize: 20 })
}

interface Props {
  page: Page<CollectionEntry<'notes'>>
}
const { page } = Astro.props
const allNotes = (await getCollection('notes')).filter((entry) => !entry.data.draft)
const topics = getNoteTopics(allNotes)
const tags = [...new Set(allNotes.flatMap((entry) => entry.data.tags))].sort()
const statusLabels: Record<string, string> = {
  'in-progress': '整理中',
  incomplete: '待补充',
  archived: '已归档'
}
const meta = {
  title: '学习笔记',
  description: '计算机系统、算法与人工智能的学习笔记。沿着问题，慢慢深入。'
}
const paginationProps = {
  ...(page.url.prev && { prevUrl: { text: '← 上一页', url: page.url.prev } }),
  ...(page.url.next && { nextUrl: { text: '下一页 →', url: page.url.next } })
}
---

<PageLayout {meta}>
  <main class='index-page'>
    <header class='page-masthead' id='content-header'>
      <p class='eyebrow'>THE NOTEBOOK / {String(allNotes.length).padStart(2, '0')} ENTRIES</p>
      <h1>学习笔记<em>Notes.</em></h1>
      <p>
        把零散的知识连成线，把遇到的问题记下来。<br
        />这里是我的学习现场，也是一份持续整理的个人知识索引。
      </p>
    </header>

    {
      page.currentPage === 1 && topics.length > 0 && (
        <section class='topic-overview' aria-label='按专题阅读'>
          <p class='eyebrow'>按专题阅读</p>
          <NoteTopicIndex {topics} />
        </section>
      )
    }

    <div class='catalog-layout'>
      <section id='content' aria-label='笔记列表'>
        <div class='catalog-label'>
          <span>全部笔记 / 按更新排列</span>
          <span
            >{page.total} 篇{page.lastPage > 1 && ` · ${page.currentPage} / ${page.lastPage}`}</span
          >
        </div>
        <ul class='entry-list'>
          {
            page.data.map((entry) => (
              <EntryRow
                href={`/notes/${entry.id}`}
                title={entry.data.title}
                description={entry.data.description}
                date={entry.data.updatedDate ?? entry.data.date}
                status={statusLabels[entry.data.status]}
              />
            ))
          }
        </ul>
        {
          page.lastPage > 1 && (
            <div class='mt-8'>
              <Paginator {...paginationProps} />
            </div>
          )
        }
      </section>
      <aside class='catalog-aside' aria-label='按主题寻找'>
        <h2>沿着主题寻找</h2>
        <ul class='tag-index'>
          {
            tags.map((tag) => (
              <li>
                <a href={`/notes/tags/${tag}`}>{tag}</a>
              </li>
            ))
          }
        </ul>
        <a href='/notes/tags'>全部标签 ↗</a>
        <h2 class='mt-10'>关于这些笔记</h2>
        <p>记录当前的理解，也为之后的修正留一点余地。</p>
      </aside>
    </div>
  </main>
</PageLayout>
