---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import { Paginator } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import EntryRow from '@/components/EntryRow.astro'
import config from '@/site-config'

export const prerender = true
export const getStaticPaths = (async ({ paginate }) =>
  paginate(sortMDByDate(await getBlogCollection()), {
    pageSize: config.content.blogPageSize
  })) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'blog'>>
}
const { page } = Astro.props
const paginationProps = {
  ...(page.url.prev && { prevUrl: { text: '← 上一页', url: page.url.prev } }),
  ...(page.url.next && { nextUrl: { text: '下一页 →', url: page.url.next } })
}
---

<PageLayout meta={{ title: '文章', description: '关于技术、学习与实践的长一点的思考。' }}>
  <main class='index-page'>
    <header class='page-masthead' id='content-header'>
      <p class='eyebrow'>ESSAYS & REFLECTIONS</p>
      <h1>写下来<em>Writing.</em></h1>
      <p>一些值得展开的问题，一些想留下的思考。<br />关于技术、学习，也关于实践之后的新理解。</p>
    </header>
    <section id='content' aria-label='文章列表'>
      <div class='catalog-label'>
        <span>{page.total} 篇文章</span><a href='/archives'>按年份阅读 ↗</a>
      </div>
      <ul class='entry-list'>
        {
          page.data.map((post) => (
            <EntryRow
              href={`/blog/${post.id}`}
              title={post.data.title}
              description={post.data.description}
              date={post.data.updatedDate ?? post.data.publishDate}
              category={post.data.tags.join(' / ')}
            />
          ))
        }
      </ul>
      {
        page.lastPage > 1 && (
          <div class='mt-8'>
            <Paginator {...paginationProps} />
          </div>
        )
      }
    </section>
  </main>
</PageLayout>
