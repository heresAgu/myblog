---
import PageLayout from '@/layouts/CommonPage.astro'
import GitHubContributions from '@/components/projects/GitHubContributions.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'projects', text: 'Projects' }
]
---

<PageLayout title='Projects' {headings} info={{ slug: '/projects', hideComment: true }}>
  <p>My projects and learning work.</p>

  <GitHubContributions username='heresAgu' />

  <h2 id='projects'>Projects</h2>

  <ProjectSection
    analyticsSection='projects'
    project={[
      {
        id: 'pytorch-project',
        name: '经典模型实现',
        description: 'Transformer、ViT、LLaMA 等经典深度学习模型的实现与学习。',
        links: [
          { type: 'github', href: 'https://github.com/heresAgu/pytorch-project' }
        ]
      },
      {
        id: 'deep-learning',
        name: 'Deep Learning/CS224N',
        description: '深度学习模型与实验，记录模型实现、训练和相关实验。',
        links: [
          { type: 'github', href: 'https://github.com/heresAgu/deep-learning' }
        ]
      },
      {
        id: 'fundamental-algorithm',
        name: '算法基础',
        description: '数据结构与经典算法的学习、实现与练习。',
        links: [
          {
            type: 'github',
            href: 'https://github.com/heresAgu/Fundamental-Algorithm-Learning-FromAgu'
          }
        ]
      },
      {
  id: 'bupt-intelligence-calendar',
  name: '北邮日历',
  description: '面向北邮学生的学习与校园日历小程序。',
  links: [
    {
      type: 'github',
      href: 'https://github.com/heresAgu/BUPT-intelligence-calendar'
    }
  ]
}
    ]}
  />
</PageLayout>