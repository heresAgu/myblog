---
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'

export const prerender = true

const meta = {
  description: '页面不存在',
  noindex: true,
  title: '404'
}
---

<PageLayout {meta}>
  <div class='px-4 py-10 text-center sm:px-6 lg:px-8'>
    <h1 class='block text-7xl font-bold sm:text-9xl'>404</h1>
    <p class='mt-3 text-muted-foreground'>抱歉，页面出现了一些问题。</p>
    <p class='text-lg'>我们找不到你要访问的页面。</p>
    <Button title='返回首页' href='/' style='ahead' class='mt-5' />
  </div>
</PageLayout>